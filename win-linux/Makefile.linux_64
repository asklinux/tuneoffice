qmake: FORCE
	@$(QMAKE) -o Makefile.linux_64 ASCDocumentEditor.pro -nocache 'CONFIG+=desktop core_disable_all_warnings  disable_precompiled_header' URL_WEBAPPS_HELP=https://download.tuneoffice.com/install/desktop/editors/help/v9.4.0/apps -qtconf /home/data/tunnelbiz/tuneoffice/build_tools/tools/linux/qt_build/Qt-5.9.9/gcc_64/tuneoffice_qt.conf

qmake_all: FORCE


all: Makefile.linux_64 $(TARGET)

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents res/gresource.xml $(DISTDIR)/
	$(COPY_FILE) --parents resources.qrc $(DISTDIR)/
	$(COPY_FILE) --parents ../../build_tools/tools/linux/qt_build/Qt-5.9.9/gcc_64/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents src/windows/cmainwindow.h src/windows/cwindowbase.h src/windows/ceditorwindow.h src/windows/ceditorwindow_p.h src/windows/cpresenterwindow.h src/components/asctabwidget.h src/components/cdownloadwidget.h src/components/cpushbutton.h src/components/cfiledialog.h src/components/cprintprogress.h src/components/ctabbar.h src/components/cmessage.h src/components/canimatedicon.h src/components/ctabpanel.h src/components/csvgpushbutton.h src/components/celipsislabel.h src/components/cfullscrwidget.h src/components/cprintdialog.h src/components/ctooltip.h src/components/cmenu.h src/version.h src/defines.h src/ccefeventstransformer.h src/cascapplicationmanagerwrapper.h src/cascapplicationmanagerwrapper_private.h src/casctabdata.h src/utils.h src/chelp.h src/cfilechecker.h src/clogger.h src/clangater.h src/cprintdata.h src/cproviders.h src/cscalingwrapper.h src/ctabundockevent.h src/ccefeventsgate.h src/ceditortools.h src/cwindowsqueue.h src/ceventdriver.h src/cappeventfilter.h src/iconfactory.h src/cthemes.h src/windows/platform_linux/cx11decoration.h src/windows/platform_linux/cwindowplatform.h src/components/cnotification.h src/platform_linux/cdialogopenssl.h src/platform_linux/cdialogcertificateinfo.h src/platform_linux/singleapplication.h src/platform_linux/xdgdesktopportal.h src/platform_linux/gtkfilechooser.h src/platform_linux/gtkprintdialog.h src/platform_linux/gtkutils.h src/platform_linux/xcbutils.h extras/update-daemon/src/classes/csocket.h src/prop/defines_p.h src/prop/cascapplicationmanagerwrapperintf.h src/prop/version_p.h src/prop/cmainwindowimpl.h $(DISTDIR)/
